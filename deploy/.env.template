# ============================================================================
# Family Calendar Backend - Environment Variables for Oracle Cloud VM
# Copy this to /home/ubuntu/family-calendar/backend/.env and fill in values
# ============================================================================

# Database (local PostgreSQL on the VM - no changes needed)
DATABASE_URL=postgresql://dashboard:dashboard_secret@127.0.0.1:5432/family_dashboard

# Google OAuth
# Copy these from your existing backend/.env on your PC
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
# IMPORTANT: Update this to your VM's public IP after creation
GOOGLE_REDIRECT_URI=http://<VM_PUBLIC_IP>:3000/api/auth/google/callback

# OpenWeatherMap
OPENWEATHER_API_KEY=<your-openweather-api-key>

# Google Maps
GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>

# Unsplash (stock photos for calendar events)
UNSPLASH_ACCESS_KEY=<your-unsplash-access-key>

# Gemini (Flash for search query generation)
GEMINI_API_KEY=<your-gemini-api-key>

# Server
PORT=3000
NODE_ENV=production
FRONTEND_URL=http://<VM_PUBLIC_IP>:8081
